[Unit]
Description=CoreX QA2 Laravel queue worker - buyer-matching (RegenerateBuyerMatchesJob, ~8 min) (dedicated lane; AT-523: a queue the code dispatches to must have a worker) - QA-scoped, do not use for live/staging
After=network.target mysql.service

[Service]
User=www-data
Group=www-data
Restart=always
RestartSec=3
WorkingDirectory=/corex-qa2
ExecStart=/usr/bin/php /corex-qa2/artisan queue:work --queue=buyer-matching --sleep=3 --tries=1 --timeout=610 --max-time=3600
StandardOutput=append:/var/log/corex-qa2-queue-buyer-matching.log
StandardError=append:/var/log/corex-qa2-queue-buyer-matching.log

[Install]
WantedBy=multi-user.target
