[Unit]
Description=CoreX QA2 Laravel queue worker - transcription (TranscribeVoiceNoteJob, up to 20 min) (dedicated lane; AT-523: a queue the code dispatches to must have a worker) - QA-scoped, do not use for live/staging
After=network.target mysql.service

[Service]
User=www-data
Group=www-data
Restart=always
RestartSec=3
WorkingDirectory=/corex-qa2
ExecStart=/usr/bin/nice -n 10 /usr/bin/php /corex-qa2/artisan queue:work --queue=transcription --sleep=3 --tries=1 --timeout=1260 --max-time=3600
StandardOutput=append:/var/log/corex-qa2-queue-transcription.log
StandardError=append:/var/log/corex-qa2-queue-transcription.log

[Install]
WantedBy=multi-user.target
