[Unit]
Description=CoreX QA1 Laravel queue worker - thumbnails (DownloadListingThumbnail, network-bound, bulk) (dedicated lane; AT-523: a queue the code dispatches to must have a worker) - QA-scoped, do not use for live/staging
After=network.target mysql.service

[Service]
User=www-data
Group=www-data
Restart=always
RestartSec=3
WorkingDirectory=/corex-qa1
ExecStart=/usr/bin/php /corex-qa1/artisan queue:work --queue=thumbnails --sleep=3 --tries=3 --timeout=90 --max-time=3600
StandardOutput=append:/var/log/corex-qa1-queue-thumbnails.log
StandardError=append:/var/log/corex-qa1-queue-thumbnails.log

[Install]
WantedBy=multi-user.target
