[Unit]
Description=CoreX QA1 Laravel queue worker - thumbnails, second worker while the 2,900-job backlog drains (remove the unit when it is empty) (dedicated lane; AT-523: a queue the code dispatches to must have a worker) - QA-scoped, do not use for live/staging
After=network.target mysql.service

[Service]
User=www-data
Group=www-data
Restart=always
RestartSec=3
WorkingDirectory=/corex-qa1
ExecStart=/usr/bin/php /corex-qa1/artisan queue:work --queue=thumbnails --sleep=3 --tries=3 --timeout=90 --max-time=3600
StandardOutput=append:/var/log/corex-qa1-queue-thumbnails-2.log
StandardError=append:/var/log/corex-qa1-queue-thumbnails-2.log

[Install]
WantedBy=multi-user.target
