    {
      "task": "Marketing published",
      "event": "App\\Events\\Marketing\\MarketingPostPublished",
      "filter": {},
      "note": "Overlaps the Facebook task; Johan picks which stays."
    },
    {
      "task": "Take out Buyers",
      "event": "App\\Events\\Viewing\\ViewingScheduled",
      "filter": {},
      "note": "Two tasks named Take out Buyers; one binds, the other retires with the calendar mapping 'viewing'."
    },
    {
      "task": "Sign an OTP",
      "event": "App\\Events\\Docuperfect\\OtpSigned",
      "filter": {}
    },
    {
      "task": "Deal created",
      "event": "App\\Events\\Deal\\DealCreated",
      "filter": {},
      "note": "Credits every agent on the deal. 'Deal listing side' and 'Deal selling side' are covered by it."
    },
    {
      "task": "Deal stage advanced",
      "event": "App\\Events\\Deal\\DealStageAdvanced",
      "filter": {}
    },
    {
      "task": "Deal registered",
      "event": "App\\Events\\Deal\\DealClosed",
      "filter": {
        "outcome": "won"
      },
      "note": "The listing-side and selling-side registered tasks are covered by it."
    },
    {
