    {
      "task": "Presentation lost",
      "event": "App\\Events\\Presentation\\PresentationOutcomeRecorded",
      "filter": {
        "outcome": "lost_to_competitor"
      },
      "note": "Several lost_to_* outcomes exist; a filter matches one value. Johan chooses one task per outcome, or the engine gains a prefix match."
